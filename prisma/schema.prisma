datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  DOCTOR
  AGRONOMIST
  ADMIN
}

enum DangerLevel {
  deadly
  mild
  harmless
}

enum VenomCategory {
  neurotoxic
  hemotoxic
  cytotoxic
  myotoxic
  non_venomous
}

enum PestCategory {
  crop_pest
  stinging_insect
}

enum PestSeverity {
  critical
  moderate
  low
}

enum TreatmentType {
  organic
  chemical
}

// ----------------------------------------------------
// 1. User & Authentication
// ----------------------------------------------------
model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  name            String
  phone           String?
  role            Role             @default(USER)
  identifications Identification[]
  emergencyCalls  EmergencyLog[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("users")
}

// ----------------------------------------------------
// 2. Snake & Antivenom Domain
// ----------------------------------------------------
model Snake {
  id                   String           @id
  scientificName       String           @unique
  family               String
  commonNames          Json             // { "en": "...", "bn": "...", "hi": "...", ... }
  isVenomous           Boolean
  dangerLevel          DangerLevel
  venomCategory        VenomCategory
  antivenomRequired    Boolean
  antivenomType        String?
  commercialBrands     String[]
  targetToxins         String[]
  lethalityRisk        String
  habitat              String
  distribution         String[]
  imageUrl             String
  firstAidSteps        String[]
  mythsDebunked        String[]
  ecologicalImportance String
  identifications      Identification[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@map("snakes")
}

// ----------------------------------------------------
// 3. Agricultural Pest & Treatment Domain
// ----------------------------------------------------
model Pest {
  id                 String           @id
  scientificName     String           @unique
  commonNames        Json             // { "en": "...", "bn": "...", ... }
  category           PestCategory     @default(crop_pest)
  affectedCrops      String[]         // ['mango', 'litchi', 'rice']
  severity           PestSeverity
  symptoms           String[]
  damageMechanism    String
  yieldLossPotential String
  stingRemedy        String?
  imageUrl           String
  treatments         Treatment[]
  identifications    Identification[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("pests")
}

model Treatment {
  id                     String        @id @default(uuid())
  pestId                 String
  pest                   Pest          @relation(fields: [pestId], references: [id], onDelete: Cascade)
  type                   TreatmentType
  title                  String
  activeIngredient       String
  dosagePerLiter         Float
  dosageUnit             String        // 'ml' or 'g'
  commercialExamples     String[]
  optimalTiming          String
  preHarvestIntervalDays Int           @default(0)
  safetyInstructions     String
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@map("treatments")
}

// ----------------------------------------------------
// 4. Hospitals & Antivenom Centers
// ----------------------------------------------------
model Hospital {
  id                String         @id
  name              String
  country           String         @default("BD")
  district          String
  division          String
  hotline           String
  hasAntivenomStock Boolean        @default(true)
  address           String
  latitude          Float
  longitude         Float
  emergencyUnit     String?
  icuAvailable      Boolean        @default(true)
  emergencyLogs     EmergencyLog[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("hospitals")
}

// ----------------------------------------------------
// 5. Identification & Diagnostic Logs
// ----------------------------------------------------
model Identification {
  id             String      @id @default(uuid())
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  type           String      // 'snake' | 'pest'
  imageUrl       String
  userRegion     String?
  cropType       String?
  confidence     Float
  rawAiOutput    Json
  snakeId        String?
  snake          Snake?      @relation(fields: [snakeId], references: [id])
  pestId         String?
  pest           Pest?       @relation(fields: [pestId], references: [id])
  isCorrect      Boolean?    // User feedback
  createdAt      DateTime    @default(now())

  @@map("identifications")
}

// ----------------------------------------------------
// 6. Emergency Call & SOS Dispatch Log
// ----------------------------------------------------
model EmergencyLog {
  id          String    @id @default(uuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  hospitalId  String?
  hospital    Hospital? @relation(fields: [hospitalId], references: [id])
  callerPhone String?
  latitude    Float?
  longitude   Float?
  notes       String?
  createdAt   DateTime  @default(now())

  @@map("emergency_logs")
}

